<Window x:Class="RadioReel.App.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:RadioReel.App.UI.Views.Tabs"
        xmlns:panels="clr-namespace:RadioReel.App.UI.Views.Panels"
        Title="RadioReel"
        Width="800" Height="500"
        MinWidth="600" MinHeight="400"
        AutomationProperties.Name="RadioReel — запис інтернет-радіо">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Streams.StartRecordingCommand}" />
        <KeyBinding Key="F6" Command="{Binding Streams.StopRecordingCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding Streams.AddStreamCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- Hidden live region blocks for screen reader announcements -->
        <Grid Visibility="Collapsed">
            <TextBlock x:Name="AssertiveLiveRegion"
                       AutomationProperties.LiveSetting="Assertive" />
            <TextBlock x:Name="PoliteLiveRegion"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <DockPanel>
            <!-- Menu -->
            <Menu DockPanel.Dock="Top"
                  AutomationProperties.Name="Головне меню">
                <MenuItem Header="Файл" AutomationProperties.Name="Файл">
                    <MenuItem Header="Вихід"
                              InputGestureText="Alt+F4"
                              Click="OnExitClick"
                              AutomationProperties.Name="Вихід" />
                </MenuItem>
                <MenuItem Header="Потік" AutomationProperties.Name="Потік">
                    <MenuItem Header="Додати потік..."
                              InputGestureText="Ctrl+N"
                              Command="{Binding Streams.AddStreamCommand}"
                              AutomationProperties.Name="Додати потік" />
                    <Separator />
                    <MenuItem Header="Почати запис"
                              InputGestureText="F5"
                              Command="{Binding Streams.StartRecordingCommand}"
                              AutomationProperties.Name="Почати запис" />
                    <MenuItem Header="Зупинити запис"
                              InputGestureText="F6"
                              Command="{Binding Streams.StopRecordingCommand}"
                              AutomationProperties.Name="Зупинити запис" />
                </MenuItem>
            </Menu>

            <!-- StatusBar -->
            <panels:StatusBar DockPanel.Dock="Bottom" DataContext="{Binding}" />

            <!-- Content (last child fills remaining space) -->
            <TabControl AutomationProperties.Name="Основні вкладки">
                <TabItem Header="Потоки"
                         AutomationProperties.Name="Потоки">
                    <tabs:StreamsTab DataContext="{Binding Streams}" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
