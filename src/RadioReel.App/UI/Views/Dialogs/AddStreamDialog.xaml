<Window x:Class="RadioReel.App.UI.Views.Dialogs.AddStreamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати потік"
        Width="450" Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AutomationProperties.Name="Діалог додавання потоку">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- URL -->
        <Label Grid.Row="0" Grid.Column="0"
               Content="URL потоку:"
               Target="{Binding ElementName=UrlTextBox}"
               VerticalAlignment="Center" />
        <TextBox x:Name="UrlTextBox"
                 Grid.Row="0" Grid.Column="2"
                 AutomationProperties.Name="URL потоку"
                 AutomationProperties.IsRequiredForForm="True"
                 TabIndex="0" />

        <!-- Name -->
        <Label Grid.Row="2" Grid.Column="0"
               Content="Назва станції:"
               Target="{Binding ElementName=NameTextBox}"
               VerticalAlignment="Center" />
        <TextBox x:Name="NameTextBox"
                 Grid.Row="2" Grid.Column="2"
                 AutomationProperties.Name="Назва станції"
                 AutomationProperties.HelpText="Необов'язкове. Якщо порожнє — визначиться автоматично."
                 TabIndex="1" />

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Додати"
                    IsDefault="True"
                    Click="OnAddClick"
                    AutomationProperties.Name="Додати"
                    TabIndex="2"
                    MinWidth="80" Margin="0,0,8,0" />
            <Button Content="Скасувати"
                    IsCancel="True"
                    AutomationProperties.Name="Скасувати"
                    TabIndex="3"
                    MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
