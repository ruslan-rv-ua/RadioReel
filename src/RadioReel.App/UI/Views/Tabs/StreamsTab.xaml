<UserControl x:Class="RadioReel.App.UI.Views.Tabs.StreamsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Вкладка потоків">

    <DockPanel Margin="8">
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Почати запис"
                    Command="{Binding StartRecordingCommand}"
                    ToolTip="Почати запис (F5)"
                    AutomationProperties.Name="Почати запис"
                    TabIndex="0"
                    Margin="0,0,8,0" />
            <Button Content="Зупинити запис"
                    Command="{Binding StopRecordingCommand}"
                    ToolTip="Зупинити запис (F6)"
                    AutomationProperties.Name="Зупинити запис"
                    TabIndex="1"
                    Margin="0,0,8,0" />
        </StackPanel>

        <!-- Stream list -->
        <ListView ItemsSource="{Binding Streams}"
                  SelectedItem="{Binding SelectedStream}"
                  AutomationProperties.Name="Список потоків"
                  TabIndex="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Назва станції"
                                    DisplayMemberBinding="{Binding Name}"
                                    Width="200" />
                    <GridViewColumn Header="Статус"
                                    DisplayMemberBinding="{Binding Status}"
                                    Width="120" />
                    <GridViewColumn Header="Поточний трек"
                                    DisplayMemberBinding="{Binding CurrentTrack}"
                                    Width="300" />
                </GridView>
            </ListView.View>
            <ListView.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Почати запис"
                              Command="{Binding StartRecordingCommand}"
                              AutomationProperties.Name="Почати запис" />
                    <MenuItem Header="Зупинити запис"
                              Command="{Binding StopRecordingCommand}"
                              AutomationProperties.Name="Зупинити запис" />
                    <Separator />
                    <MenuItem Header="Видалити потік"
                              Command="{Binding RemoveStreamCommand}"
                              AutomationProperties.Name="Видалити потік" />
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </DockPanel>
</UserControl>
